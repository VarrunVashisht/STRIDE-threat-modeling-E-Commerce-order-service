              "privilegeLevel": "",
              "threats": [
                {
                  "id": "f5b24580-f9da-4a19-a1b5-a98f5546f762",
                  "title": "JWT Token Impersonation",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Attackers use stolen or forged JWTs to access customer or admin APIs.\n\nA **JWT (JSON Web Token)** is like a **digital ID card** used in web applications to prove who you are after login.\n\n## Simple Flow\n\n1. You log in with username/password.\n2. Server checks your credentials.\n3. Server gives you a JWT token.\n4. Your app sends this token with every request.\n5. Server verifies the token and allows access.\n\n---\n\n## Real-World Analogy\n\nThink of JWT as a **hotel access card**:\n\n* Reception verifies your identity once.\n* They give you a card (JWT).\n* You use the card to open your room instead of showing ID every time.\n\n---\n\n## What’s Inside a JWT?\n\nA JWT usually contains:\n\n* User ID\n* Role (`customer`, `admin`)\n* Expiration time\n* Signature (to prevent tampering)\n\nExample:\n\n```json\n{\n  \"userId\": 101,\n  \"role\": \"customer\",\n  \"exp\": 1750000000\n}\n```\n\n---\n\n## Why JWT is Popular in NestJS APIs\n\n* Stateless authentication\n* Fast validation\n* Works well with microservices\n* Easy for mobile/web apps\n\n---\n\n## Important Security Rules\n\n### Good Practice\n\n* Use HTTPS only\n* Set token expiration\n* Store secrets securely\n* Validate signature properly\n\n### Bad Practice\n\n* Never trust unsigned tokens\n* Never store sensitive data inside JWT\n* Don’t use very long expiration times\n\n---\n\n",
                  "mitigation": "Use RS256/ES256 signing, rotate secrets regularly, enforce MFA for privileged users, validate JWT issuer/audience, and implement short token expiration.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "fcb2db7b-6f3a-4e97-b6bb-bf48312e8b06",
                  "title": "SQL Injection on Order APIs",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "Malicious input manipulates PostgreSQL queries and modifies order/customer records.",
                  "mitigation": "Enforce parameterized queries via ORM, validate DTOs with class-validator, sanitize inputs, disable unsafe raw SQL, and apply least-privilege DB access.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "37180d76-a854-4f91-813b-00a0c502bcd2",
                  "title": "Missing Audit Logging",
                  "status": "Mitigated",
                  "severity": "TBD",
                  "type": "Repudiation",
                  "description": "Users or admins deny creating, updating, or canceling orders due to insufficient traceability.",
                  "mitigation": "Enable immutable audit logs, log user ID/IP/request ID, centralize logs in SIEM, sync server time with NTP, and protect logs from modification.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "d8cbe1b4-dff2-403b-94ec-d3a4d3c76d91",
                  "title": "Customer Data Leakage",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "description": "APIs, logs, or database exposure reveal sensitive customer/order information.",
                  "mitigation": "Encrypt sensitive data at rest and in transit, mask PII in logs, enforce RBAC guards, disable verbose production errors, and restrict DB/network access.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "e62a9881-c06a-4d73-97eb-ec77c0517f5f",
                  "title": "API Flooding / Resource Exhaustion",
                  "status": "NotApplicable",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Attackers overwhelm NestJS APIs or PostgreSQL with excessive requests.",
                  "mitigation": "Apply API rate limiting, enable WAF/CDN protections, configure DB connection pooling, implement request timeouts, and autoscale services where possible.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "95b14a21-4c1d-4bb1-8abb-7484b7e594f9",
                  "title": "Broken Authorization Controls",
                  "status": "Mitigated",
                  "severity": "TBD",
                  "type": "Elevation of privilege",
                  "description": "Normal users gain admin-level access to orders or customer data.",
                  "mitigation": "Enforce RBAC/ABAC guards in NestJS, validate ownership checks on every request, separate admin/user roles, and conduct regular authorization testing.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "860801f1-dc7b-4c59-a1f0-3f0e4a73cb01",
